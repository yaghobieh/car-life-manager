    "@forgedevstack/harbor": "^1.6.4",
    "@prisma/client": "^6.7.0",
    "express": "^4.21.2",
    "mongodb": "^6.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "prisma": "^6.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
