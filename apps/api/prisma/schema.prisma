generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicles  Vehicle[]
  audits    AuditLog[]
}

model Vehicle {
  id                          String   @id @default(cuid())
  userId                      String
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationNumber          String
  formattedRegistrationNumber String
  make                        String?
  model                       String?
  modelYear                   Int?
  fuelType                    String?
  engine                      String?
  color                       String?
  registrationDate            String?
  registrationExpiry          String?
  lastTestDate                String?
  nextTestDate                String?
  ownershipSequence           Int?
  ownershipType               String?
  mileage                     Int?
  dataSource                  String
  dataProvenance              String
  dataSourceUpdatedAt         DateTime
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  tasks                       Task[]
  expenses                    Expense[]
  documents                   VehicleDocument[]
  maintenance                 MaintenanceRecord[]
  reminders                   Reminder[]
  lookups                     VehicleLookupCache[]

  @@index([userId])
  @@index([registrationNumber])
  @@unique([userId, registrationNumber])
}

model Task {
  id           String    @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  title        String
  description  String
  category     String
  priority     String
  status       String
  dueDate      String?
  provider     String?
  source       String
  externalUrl  String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([vehicleId])
  @@index([status])
  @@index([dueDate])
}

model Expense {
  id           String   @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category     String
  amount       Float
  currency     String   @default("ILS")
  merchant     String?
  occurredAt   DateTime
  description  String?
  recurring    Boolean  @default(false)
  attachmentId String?
  createdAt    DateTime @default(now())

  @@index([vehicleId])
  @@index([occurredAt])
}

model VehicleDocument {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type       String
  title      String
  notes      String?
  expiresAt  String?
  storageKey String
  createdAt  DateTime @default(now())
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceDate String
  mileage     Int?
  garage      String?
  serviceType String
  parts       String?
  cost        Float?
  notes       String?
  createdAt   DateTime @default(now())
}

model Reminder {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  title      String
  dueDate    String
  remindAt   String?
  recurrence String?
  status     String   @default("upcoming")
  createdAt  DateTime @default(now())
}

model VehicleLookupCache {
  id                   String   @id @default(cuid())
  vehicleId            String?
  vehicle              Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  registrationNumber   String
  payload              String
  source               String
  fetchedAt            DateTime
  expiresAt            DateTime

  @@index([registrationNumber])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String?
  action    String
  metadata  String
  createdAt DateTime @default(now())
}
