{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@const": [
        "../../packages/common/src/constants"
      ],
      "@logger": [
        "../../packages/common/src/logger"
      ],
      "@locales": [
        "../../packages/common/src/locales"
      ],
      "@theme": [
        "../../packages/common/src/theme"
      ],
      "@common": [
        "../../packages/common/src/common"
      ],
      "@components": [
        "../../packages/common/src/components"
      ],
      "@components/*": [
        "../../packages/common/src/components/*"
      ],
      "@api": [
        "../../packages/sdk/src/api"
      ],
      "@store": [
        "../../packages/sdk/src/store"
      ],
      "@hooks": [
        "../../packages/sdk/src/store/hooks"
      ],
      "@connected": [
        "../../packages/sdk/src/components"
      ],
      "@connected/*": [
        "../../packages/sdk/src/components/*"
      ],
      "@pages": [
        "src/pages"
      ],
      "@pages/*": [
        "src/pages/*"
      ],
      "@routes": [
        "src/Route.utils.ts"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "vite.aliases.ts"
  ]
}
