{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@const": ["src/constants"],
      "@hooks": ["src/hooks"],
      "@pages": ["src/pages"],
      "@components/*": ["src/components/*"],
      "@components": ["src/components"],
      "@store": ["src/store"],
      "@locales": ["src/locales"],
      "@api": ["src/api"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "vite.aliases.ts"]
}
