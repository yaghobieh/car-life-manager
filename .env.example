# API
PORT=4173
HOST=0.0.0.0
NODE_ENV=development
AUTH_SECRET=change-me
# Prisma talks to this database. Prisma is not the database.
# Hosted Neon (pooled) + direct (non-pooler) for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
WEB_ORIGIN="http://127.0.0.1:5188"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://127.0.0.1:5188/api/auth/google/callback"
ENABLE_LOGS=
BUILD_SHA=
APP_VERSION=1.0.0

# Public vehicle lookup — official CKAN datastore on data.gov.il
DATA_GOV_IL_URL=https://data.gov.il/api/3/action/datastore_search
MINISTRY_TRANSPORT_RESOURCE_ID=053cea08-09bc-40ec-8f7a-156f0677aff3
VEHICLE_LOOKUP_CACHE_TTL_MS=86400000

# development | official
# official always calls data.gov.il. development may fall back to a labeled mock.
VEHICLE_DATA_SOURCE=official

# Planned integrations (leave empty until a real partnership/API exists)
HIGHWAY6_API_URL=
PANGO_API_URL=
CELLO_API_URL=
STORAGE_URL=
IDENTITY_PROVIDER_URL=
