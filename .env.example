# API
PORT=4173
HOST=0.0.0.0
NODE_ENV=development
AUTH_SECRET=change-me
# Prisma talks to this database. Prisma is not the database.
# Neon pooled URL. Required on Vercel. Migrations can use the same URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
WEB_ORIGIN="http://127.0.0.1:5188"

# Auth0 — copy from Applications → Settings. Secret stays on the API only.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_CALLBACK_URL="http://127.0.0.1:5188/api/auth/auth0/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://127.0.0.1:5188/api/auth/google/callback"
ENABLE_LOGS=
BUILD_SHA=
APP_VERSION=1.0.3

# Public vehicle lookup — official CKAN datastore on data.gov.il
DATA_GOV_IL_URL=https://data.gov.il/api/3/action/datastore_search
MINISTRY_TRANSPORT_RESOURCE_ID=053cea08-09bc-40ec-8f7a-156f0677aff3
MINISTRY_RECALL_RESOURCE_ID=36bf1404-0be4-49d2-82dc-2f1ead4a8b93
VEHICLE_LOOKUP_CACHE_TTL_MS=86400000

# development | official
# official always calls data.gov.il. development may fall back to a labeled mock.
VEHICLE_DATA_SOURCE=official

# Optional provider hub (RapidAPI / custom). Must return JSON
# { "verified": true, "status": "connected" } or the provider stays unsupported.
PROVIDER_HUB_URL=
PROVIDER_HUB_KEY=
HIGHWAY6_API_URL=
PANGO_API_URL=
CELLO_API_URL=
STORAGE_URL=
IDENTITY_PROVIDER_URL=

# Email reminders (Resend). Without this key, email stays skipped.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Car Life Manager <noreply@your-domain.com>"

# SMS reminders (Twilio). Without all three, SMS stays skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Document files (Cloudinary). Without this, local disk is used in development only.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Optional non-pooler URL for prisma migrate deploy on Vercel.
DATABASE_DIRECT_URL=
